rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'singhshriyansh51@gmail.com'
      );
    }

    // Legacy & Core Studio Validation Blueprints
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'studioId', 'role', 'onboardingStep', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'studioId', 'role', 'onboardingStep', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.studioId is string && data.studioId.size() >= 1 && data.studioId.size() <= 128 && data.studioId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.role is string && data.role in ['studio_owner', 'studio_admin', 'photographer', 'photo_editor', 'customer', 'event_guest'] &&
        data.onboardingStep is int && data.onboardingStep >= 1 && data.onboardingStep <= 6 &&
        data.createdAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'phone', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
        data.createdAt is timestamp;
    }

    function isValidStudio(data) {
      return data.keys().hasAll(['studioName', 'slug', 'ownerId', 'subscriptionPlan', 'subscriptionStatus', 'watermarkText', 'createdAt']) &&
        data.keys().hasOnly(['studioName', 'slug', 'ownerId', 'subscriptionPlan', 'subscriptionStatus', 'watermarkText', 'createdAt']) &&
        data.studioName is string && data.studioName.size() >= 1 && data.studioName.size() <= 120 &&
        data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 80 && data.slug.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.subscriptionPlan is string && data.subscriptionPlan in ['starter', 'pro', 'studio_max'] &&
        data.subscriptionStatus is string && data.subscriptionStatus in ['active', 'trial', 'suspended'] &&
        data.watermarkText is string && data.watermarkText.size() >= 1 && data.watermarkText.size() <= 80 &&
        data.createdAt is timestamp;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['studioId', 'ownerId', 'projectName', 'projectType', 'eventDate', 'location', 'status', 'createdAt']) &&
        data.keys().hasOnly(['studioId', 'ownerId', 'projectName', 'projectType', 'eventDate', 'location', 'status', 'createdAt']) &&
        data.studioId is string && data.studioId.size() >= 1 && data.studioId.size() <= 128 && data.studioId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.projectName is string && data.projectName.size() >= 1 && data.projectName.size() <= 140 &&
        data.projectType is string && data.projectType in ['wedding', 'pre_wedding', 'event', 'portrait', 'editorial', 'corporate'] &&
        data.eventDate is string && data.eventDate.size() >= 1 && data.eventDate.size() <= 40 &&
        data.location is string && data.location.size() >= 1 && data.location.size() <= 140 &&
        data.status is string && data.status in ['planning', 'shooting', 'culling', 'proofing', 'delivered'] &&
        data.createdAt is timestamp;
    }

    function isValidGallery(data) {
      return data.keys().hasAll(['studioId', 'projectId', 'ownerId', 'galleryName', 'accessType', 'passwordHash', 'selectionLimit', 'watermarkEnabled', 'downloadEnabled', 'status', 'createdAt']) &&
        data.keys().hasOnly(['studioId', 'projectId', 'ownerId', 'galleryName', 'accessType', 'passwordHash', 'selectionLimit', 'watermarkEnabled', 'downloadEnabled', 'status', 'createdAt']) &&
        data.studioId is string && data.studioId.size() >= 1 && data.studioId.size() <= 128 && data.studioId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.projectId is string && data.projectId.size() >= 1 && data.projectId.size() <= 128 && data.projectId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.galleryName is string && data.galleryName.size() >= 1 && data.galleryName.size() <= 140 &&
        data.accessType is string && data.accessType in ['public', 'private', 'password'] &&
        data.passwordHash is string && data.passwordHash.size() <= 128 &&
        data.selectionLimit is int && data.selectionLimit >= 1 && data.selectionLimit <= 5000 &&
        data.watermarkEnabled is bool &&
        data.downloadEnabled is bool &&
        data.status is string && data.status in ['draft', 'published', 'selection_submitted', 'locked'] &&
        data.createdAt is timestamp;
    }

    function isValidPhotoAsset(data) {
      return data.keys().hasAll(['studioId', 'galleryId', 'ownerId', 'publicId', 'secureUrl', 'fileName', 'category', 'selected', 'liked', 'createdAt']) &&
        data.keys().hasOnly(['studioId', 'galleryId', 'ownerId', 'publicId', 'secureUrl', 'fileName', 'category', 'selected', 'liked', 'createdAt']) &&
        data.studioId is string && data.studioId.size() >= 1 && data.studioId.size() <= 128 && data.studioId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.galleryId is string && data.galleryId.size() >= 1 && data.galleryId.size() <= 128 && data.galleryId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.publicId is string && data.publicId.size() >= 1 && data.publicId.size() <= 200 &&
        data.secureUrl is string && data.secureUrl.size() >= 1 && data.secureUrl.size() <= 500 &&
        data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 160 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
        data.selected is bool &&
        data.liked is bool &&
        data.createdAt is timestamp;
    }

    // PixelFotos Domain Validation Blueprints
    function isValidPixelEvent(data) {
      return data.keys().hasAll(['id', 'ownerId', 'slug', 'coupleOrHostName', 'eventType', 'eventDate', 'venueName', 'venueCity', 'googleMapsQuery', 'storyText', 'youtubeStreamUrl', 'isPublished', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'slug', 'coupleOrHostName', 'eventType', 'eventDate', 'venueName', 'venueCity', 'googleMapsQuery', 'storyText', 'youtubeStreamUrl', 'heroImageUrl', 'schedule', 'isPublished', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 100 && data.slug.matches('^[a-z0-9\\-]+$') &&
        data.coupleOrHostName is string && data.coupleOrHostName.size() >= 1 && data.coupleOrHostName.size() <= 140 &&
        data.eventType is string && data.eventType in ['Wedding', 'Engagement', 'Birthday', 'Griha Pravesh'] &&
        data.eventDate is string && data.eventDate.size() >= 1 && data.eventDate.size() <= 40 &&
        data.venueName is string && data.venueName.size() >= 1 && data.venueName.size() <= 180 &&
        data.venueCity is string && data.venueCity.size() >= 1 && data.venueCity.size() <= 120 &&
        data.googleMapsQuery is string && data.googleMapsQuery.size() <= 240 &&
        data.storyText is string && data.storyText.size() <= 1200 &&
        data.youtubeStreamUrl is string && data.youtubeStreamUrl.size() <= 400 &&
        (!('heroImageUrl' in data) || (data.heroImageUrl is string && data.heroImageUrl.size() <= 500)) &&
        (!('schedule' in data) || (data.schedule is list && data.schedule.size() <= 20)) &&
        data.isPublished is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCRMLead(data) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'phone', 'email', 'eventDate', 'packageName', 'packageValueInr', 'leadStatus', 'createdAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'name', 'phone', 'email', 'eventDate', 'packageName', 'packageValueInr', 'leadStatus', 'communicationLogs', 'createdAt']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 140 &&
        data.phone is string && data.phone.size() <= 40 &&
        data.email is string && data.email.size() <= 160 &&
        data.eventDate is string && data.eventDate.size() <= 40 &&
        data.packageName is string && data.packageName.size() <= 160 &&
        data.packageValueInr is number && data.packageValueInr >= 0 &&
        data.leadStatus is string && data.leadStatus in ['Inquiry', 'Booked', 'Editing', 'Delivered'] &&
        (!('communicationLogs' in data) || (data.communicationLogs is list && data.communicationLogs.size() <= 100)) &&
        data.createdAt is timestamp;
    }

    function isValidTeamTask(data) {
      return data.keys().hasAll(['id', 'ownerId', 'memberName', 'role', 'assignedEvent', 'taskTitle', 'progressPercent', 'createdAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'memberName', 'role', 'assignedEvent', 'taskTitle', 'progressPercent', 'createdAt']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.memberName is string && data.memberName.size() >= 1 && data.memberName.size() <= 120 &&
        data.role is string && data.role in ['Lead Photographer', 'Candid Shooter', 'Cinematographer', 'Album Editor'] &&
        data.assignedEvent is string && data.assignedEvent.size() <= 140 &&
        data.taskTitle is string && data.taskTitle.size() >= 1 && data.taskTitle.size() <= 200 &&
        data.progressPercent is number && data.progressPercent >= 0 && data.progressPercent <= 100 &&
        data.createdAt is timestamp;
    }

    function isValidStudioExpense(data) {
      return data.keys().hasAll(['id', 'ownerId', 'eventId', 'eventName', 'category', 'description', 'amountInr', 'date', 'createdAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'eventId', 'eventName', 'category', 'description', 'amountInr', 'date', 'createdAt']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        isValidId(data.eventId) &&
        data.ownerId == request.auth.uid &&
        data.eventName is string && data.eventName.size() <= 140 &&
        data.category is string && data.category in ['Travel', 'Food', 'Freelancer Payouts', 'Equipment Rental', 'Studio Overhead'] &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 240 &&
        data.amountInr is number && data.amountInr >= 0 &&
        data.date is string && data.date.size() <= 40 &&
        data.createdAt is timestamp;
    }

    function isValidPrintOrder(data) {
      return data.keys().hasAll(['id', 'ownerId', 'photoId', 'photoFileName', 'productId', 'productName', 'category', 'dimensions', 'quantity', 'clientTotalInr', 'studioProfitInr', 'customerName', 'status', 'createdAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'photoId', 'photoFileName', 'productId', 'productName', 'category', 'dimensions', 'quantity', 'clientTotalInr', 'studioProfitInr', 'customerName', 'status', 'createdAt']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.photoId is string && data.photoId.size() <= 128 &&
        data.photoFileName is string && data.photoFileName.size() <= 180 &&
        data.productId is string && data.productId.size() <= 100 &&
        data.productName is string && data.productName.size() <= 140 &&
        data.category is string && data.category.size() <= 80 &&
        data.dimensions is string && data.dimensions.size() <= 80 &&
        data.quantity is number && data.quantity >= 1 && data.quantity <= 100 &&
        data.clientTotalInr is number && data.clientTotalInr >= 0 &&
        data.studioProfitInr is number &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120 &&
        data.status is string && data.status in ['New Order', 'In Print Lab', 'Shipped'] &&
        data.createdAt is timestamp;
    }

    function isValidInvoice(data) {
      return data.keys().hasAll(['id', 'ownerId', 'docNumber', 'clientId', 'clientName', 'eventTitle', 'stage', 'status', 'includeGst18', 'advancePaidInr', 'upiId', 'createdAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'docNumber', 'clientId', 'clientName', 'eventTitle', 'stage', 'status', 'includeGst18', 'items', 'advancePaidInr', 'upiId', 'createdAt']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.docNumber is string && data.docNumber.size() >= 1 && data.docNumber.size() <= 60 &&
        data.clientId is string && data.clientId.size() <= 128 &&
        data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 140 &&
        data.eventTitle is string && data.eventTitle.size() <= 200 &&
        data.stage is string && data.stage in ['Quotation', 'Invoice'] &&
        data.status is string && data.status in ['Draft', 'Sent', 'Approved', 'Paid'] &&
        data.includeGst18 is bool &&
        (!('items' in data) || (data.items is list && data.items.size() <= 40)) &&
        data.advancePaidInr is number && data.advancePaidInr >= 0 &&
        data.upiId is string && data.upiId.size() <= 120 &&
        data.createdAt is timestamp;
    }

    // Admins Collection
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list, create, update, delete: if false;
    }

    // User Public Profile
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && existing().uid == request.auth.uid;
      allow create: if isVerifiedUser() && isValidId(userId) && isOwner(userId) &&
        isValidUserProfile(incoming()) && incoming().createdAt == request.time;
      allow update: if isVerifiedUser() && isValidId(userId) && isValidUserProfile(incoming()) && (
        isAdmin() || (
          isOwner(userId) &&
          incoming().uid == existing().uid &&
          incoming().role == existing().role &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'studioId', 'onboardingStep'])
        )
      );
      allow delete: if isValidId(userId) && isAdmin();

      // Isolated PII Subcollection
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if false;
        allow create: if isVerifiedUser() && isValidId(userId) && isValidId(docId) && docId == 'info' &&
          isOwner(userId) && isValidUserPrivateInfo(incoming()) && incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isVerifiedUser() && isValidId(userId) && isValidId(docId) && docId == 'info' &&
          isValidUserPrivateInfo(incoming()) && (
            isAdmin() || (
              isOwner(userId) &&
              incoming().uid == existing().uid &&
              incoming().createdAt == existing().createdAt &&
              incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone'])
            )
          );
        allow delete: if isValidId(userId) && isValidId(docId) && isAdmin();
      }
    }

    // Studios Collection
    match /studios/{studioId} {
      allow get: if isValidId(studioId) && ((isSignedIn() && existing().ownerId == request.auth.uid) || isAdmin());
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser() && isValidId(studioId) && isValidStudio(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isVerifiedUser() && isValidId(studioId) && isValidStudio(incoming()) && (
        isAdmin() || (
          existing().ownerId == request.auth.uid &&
          existing().subscriptionStatus != 'suspended' &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().subscriptionStatus == existing().subscriptionStatus &&
          incoming().diff(existing()).affectedKeys().hasOnly(['studioName', 'slug', 'watermarkText', 'subscriptionPlan'])
        )
      );
      allow delete: if isValidId(studioId) && isAdmin();
    }

    // Projects Collection
    match /projects/{projectId} {
      allow get: if isValidId(projectId) && (
        (isSignedIn() && existing().ownerId == request.auth.uid) || isAdmin()
      );
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser() && isValidId(projectId) && isValidProject(incoming()) &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/studios/$(incoming().studioId)) &&
        get(/databases/$(database)/documents/studios/$(incoming().studioId)).data.ownerId == request.auth.uid;
      allow update: if isVerifiedUser() && isValidId(projectId) && isValidProject(incoming()) && (
        isAdmin() || (
          existing().ownerId == request.auth.uid &&
          existing().status != 'delivered' &&
          incoming().ownerId == existing().ownerId &&
          incoming().studioId == existing().studioId &&
          incoming().createdAt == existing().createdAt &&
          exists(/databases/$(database)/documents/studios/$(existing().studioId)) &&
          get(/databases/$(database)/documents/studios/$(existing().studioId)).data.ownerId == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['projectName', 'projectType', 'eventDate', 'location', 'status'])
        )
      );
      allow delete: if isValidId(projectId) && (
        (isVerifiedUser() && existing().ownerId == request.auth.uid) || isAdmin()
      );
    }

    // Galleries Collection
    match /galleries/{galleryId} {
      allow get: if isValidId(galleryId) && (
        existing().accessType == 'public' ||
        (isSignedIn() && existing().ownerId == request.auth.uid) ||
        isAdmin()
      );
      allow list: if (isSignedIn() && existing().ownerId == request.auth.uid) || existing().accessType == 'public';
      allow create: if isVerifiedUser() && isValidId(galleryId) && isValidGallery(incoming()) &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/studios/$(incoming().studioId)) &&
        get(/databases/$(database)/documents/studios/$(incoming().studioId)).data.ownerId == request.auth.uid &&
        exists(/databases/$(database)/documents/projects/$(incoming().projectId)) &&
        get(/databases/$(database)/documents/projects/$(incoming().projectId)).data.ownerId == request.auth.uid;
      allow update: if isVerifiedUser() && isValidId(galleryId) && isValidGallery(incoming()) && (
        isAdmin() || (
          existing().ownerId == request.auth.uid &&
          existing().status != 'locked' &&
          incoming().ownerId == existing().ownerId &&
          incoming().studioId == existing().studioId &&
          incoming().projectId == existing().projectId &&
          incoming().createdAt == existing().createdAt &&
          exists(/databases/$(database)/documents/studios/$(existing().studioId)) &&
          get(/databases/$(database)/documents/studios/$(existing().studioId)).data.ownerId == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['galleryName', 'accessType', 'passwordHash', 'selectionLimit', 'watermarkEnabled', 'downloadEnabled', 'status'])
        )
      );
      allow delete: if isValidId(galleryId) && (
        (isVerifiedUser() && existing().ownerId == request.auth.uid) || isAdmin()
      );

      // Photos Subcollection
      match /photos/{photoId} {
        allow get: if isValidId(galleryId) && isValidId(photoId) && (
          (isSignedIn() && existing().ownerId == request.auth.uid) ||
          get(/databases/$(database)/documents/galleries/$(galleryId)).data.accessType == 'public' ||
          isAdmin()
        );
        allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
        allow create: if isVerifiedUser() && isValidId(galleryId) && isValidId(photoId) &&
          isValidPhotoAsset(incoming()) && incoming().galleryId == galleryId &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/galleries/$(galleryId)) &&
          get(/databases/$(database)/documents/galleries/$(galleryId)).data.ownerId == request.auth.uid;
        allow update: if isVerifiedUser() && isValidId(galleryId) && isValidId(photoId) &&
          isValidPhotoAsset(incoming()) && (
            isAdmin() || (
              existing().ownerId == request.auth.uid &&
              incoming().ownerId == existing().ownerId &&
              incoming().studioId == existing().studioId &&
              incoming().galleryId == existing().galleryId &&
              incoming().publicId == existing().publicId &&
              incoming().createdAt == existing().createdAt &&
              exists(/databases/$(database)/documents/galleries/$(galleryId)) &&
              get(/databases/$(database)/documents/galleries/$(galleryId)).data.status != 'locked' &&
              get(/databases/$(database)/documents/galleries/$(galleryId)).data.ownerId == request.auth.uid &&
              incoming().diff(existing()).affectedKeys().hasOnly(['selected', 'liked', 'category', 'fileName'])
            )
          );
        allow delete: if isValidId(galleryId) && isValidId(photoId) && (
          (isVerifiedUser() && existing().ownerId == request.auth.uid) || isAdmin()
        );
      }
    }

    // PixelFotos Studio Events & Public Microsites
    match /studio_events/{eventId} {
      allow get: if isValidId(eventId) && (
        existing().isPublished == true ||
        (isSignedIn() && existing().ownerId == request.auth.uid) ||
        isAdmin()
      );
      allow list: if existing().isPublished == true || (isSignedIn() && existing().ownerId == request.auth.uid);
      allow create: if isVerifiedUser() && isValidId(eventId) && isValidPixelEvent(incoming()) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(eventId) && isValidPixelEvent(incoming()) && (
        isAdmin() || (
          existing().ownerId == request.auth.uid &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['slug', 'coupleOrHostName', 'eventType', 'eventDate', 'venueName', 'venueCity', 'googleMapsQuery', 'storyText', 'youtubeStreamUrl', 'heroImageUrl', 'schedule', 'isPublished', 'updatedAt'])
        )
      );
      allow delete: if isValidId(eventId) && (
        (isVerifiedUser() && existing().ownerId == request.auth.uid) || isAdmin()
      );
    }

    // Studio CRM Leads
    match /crm_leads/{leadId} {
      allow get: if isValidId(leadId) && ((isSignedIn() && existing().ownerId == request.auth.uid) || isAdmin());
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser() && isValidId(leadId) && isValidCRMLead(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isVerifiedUser() && isValidId(leadId) && isValidCRMLead(incoming()) && (
        isAdmin() || (
          existing().ownerId == request.auth.uid &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['leadStatus', 'communicationLogs', 'packageName', 'packageValueInr'])
        )
      );
      allow delete: if isValidId(leadId) && ((isVerifiedUser() && existing().ownerId == request.auth.uid) || isAdmin());
    }

    // Studio Team Tasks
    match /team_tasks/{taskId} {
      allow get: if isValidId(taskId) && ((isSignedIn() && existing().ownerId == request.auth.uid) || isAdmin());
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser() && isValidId(taskId) && isValidTeamTask(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isVerifiedUser() && isValidId(taskId) && isValidTeamTask(incoming()) && (
        isAdmin() || (
          existing().ownerId == request.auth.uid &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['progressPercent', 'taskTitle', 'role'])
        )
      );
      allow delete: if isValidId(taskId) && ((isVerifiedUser() && existing().ownerId == request.auth.uid) || isAdmin());
    }

    // Studio Expenses
    match /expenses/{expenseId} {
      allow get: if isValidId(expenseId) && ((isSignedIn() && existing().ownerId == request.auth.uid) || isAdmin());
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser() && isValidId(expenseId) && isValidStudioExpense(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isVerifiedUser() && isValidId(expenseId) && isValidStudioExpense(incoming()) && (
        isAdmin() || (
          existing().ownerId == request.auth.uid &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['amountInr', 'description', 'category'])
        )
      );
      allow delete: if isValidId(expenseId) && ((isVerifiedUser() && existing().ownerId == request.auth.uid) || isAdmin());
    }

    // Print Store Orders
    match /print_orders/{orderId} {
      allow get: if isValidId(orderId) && ((isSignedIn() && existing().ownerId == request.auth.uid) || isAdmin());
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser() && isValidId(orderId) && isValidPrintOrder(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isVerifiedUser() && isValidId(orderId) && isValidPrintOrder(incoming()) && (
        isAdmin() || (
          existing().ownerId == request.auth.uid &&
          existing().status != 'Shipped' &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status'])
        )
      );
      allow delete: if isValidId(orderId) && ((isVerifiedUser() && existing().ownerId == request.auth.uid) || isAdmin());
    }

    // Invoices & Quotations
    match /invoices/{invoiceId} {
      allow get: if isValidId(invoiceId) && ((isSignedIn() && existing().ownerId == request.auth.uid) || isAdmin());
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser() && isValidId(invoiceId) && isValidInvoice(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isVerifiedUser() && isValidId(invoiceId) && isValidInvoice(incoming()) && (
        isAdmin() || (
          existing().ownerId == request.auth.uid &&
          existing().status != 'Paid' &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['docNumber', 'stage', 'status', 'advancePaidInr', 'upiId', 'includeGst18', 'items'])
        )
      );
      allow delete: if isValidId(invoiceId) && ((isVerifiedUser() && existing().ownerId == request.auth.uid) || isAdmin());
    }
  }
}
