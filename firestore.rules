rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'singhshriyansh51@gmail.com'
      );
    }

    // Entity Validation Blueprints
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'studioId', 'role', 'onboardingStep', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'studioId', 'role', 'onboardingStep', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.studioId is string && data.studioId.size() >= 1 && data.studioId.size() <= 128 && data.studioId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.role is string && data.role in ['studio_owner', 'studio_admin', 'photographer', 'photo_editor', 'customer', 'event_guest'] &&
        data.onboardingStep is int && data.onboardingStep >= 1 && data.onboardingStep <= 6 &&
        data.createdAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'phone', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
        data.createdAt is timestamp;
    }

    function isValidStudio(data) {
      return data.keys().hasAll(['studioName', 'slug', 'ownerId', 'subscriptionPlan', 'subscriptionStatus', 'watermarkText', 'createdAt']) &&
        data.keys().hasOnly(['studioName', 'slug', 'ownerId', 'subscriptionPlan', 'subscriptionStatus', 'watermarkText', 'createdAt']) &&
        data.studioName is string && data.studioName.size() >= 1 && data.studioName.size() <= 120 &&
        data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 80 && data.slug.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.subscriptionPlan is string && data.subscriptionPlan in ['starter', 'pro', 'studio_max'] &&
        data.subscriptionStatus is string && data.subscriptionStatus in ['active', 'trial', 'suspended'] &&
        data.watermarkText is string && data.watermarkText.size() >= 1 && data.watermarkText.size() <= 80 &&
        data.createdAt is timestamp;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['studioId', 'ownerId', 'projectName', 'projectType', 'eventDate', 'location', 'status', 'createdAt']) &&
        data.keys().hasOnly(['studioId', 'ownerId', 'projectName', 'projectType', 'eventDate', 'location', 'status', 'createdAt']) &&
        data.studioId is string && data.studioId.size() >= 1 && data.studioId.size() <= 128 && data.studioId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.projectName is string && data.projectName.size() >= 1 && data.projectName.size() <= 140 &&
        data.projectType is string && data.projectType in ['wedding', 'pre_wedding', 'event', 'portrait', 'editorial', 'corporate'] &&
        data.eventDate is string && data.eventDate.size() >= 1 && data.eventDate.size() <= 40 &&
        data.location is string && data.location.size() >= 1 && data.location.size() <= 140 &&
        data.status is string && data.status in ['planning', 'shooting', 'culling', 'proofing', 'delivered'] &&
        data.createdAt is timestamp;
    }

    function isValidGallery(data) {
      return data.keys().hasAll(['studioId', 'projectId', 'ownerId', 'galleryName', 'accessType', 'passwordHash', 'selectionLimit', 'watermarkEnabled', 'downloadEnabled', 'status', 'createdAt']) &&
        data.keys().hasOnly(['studioId', 'projectId', 'ownerId', 'galleryName', 'accessType', 'passwordHash', 'selectionLimit', 'watermarkEnabled', 'downloadEnabled', 'status', 'createdAt']) &&
        data.studioId is string && data.studioId.size() >= 1 && data.studioId.size() <= 128 && data.studioId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.projectId is string && data.projectId.size() >= 1 && data.projectId.size() <= 128 && data.projectId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.galleryName is string && data.galleryName.size() >= 1 && data.galleryName.size() <= 140 &&
        data.accessType is string && data.accessType in ['public', 'private', 'password'] &&
        data.passwordHash is string && data.passwordHash.size() <= 128 &&
        data.selectionLimit is int && data.selectionLimit >= 1 && data.selectionLimit <= 5000 &&
        data.watermarkEnabled is bool &&
        data.downloadEnabled is bool &&
        data.status is string && data.status in ['draft', 'published', 'selection_submitted', 'locked'] &&
        data.createdAt is timestamp;
    }

    function isValidPhotoAsset(data) {
      return data.keys().hasAll(['studioId', 'galleryId', 'ownerId', 'publicId', 'secureUrl', 'fileName', 'category', 'selected', 'liked', 'createdAt']) &&
        data.keys().hasOnly(['studioId', 'galleryId', 'ownerId', 'publicId', 'secureUrl', 'fileName', 'category', 'selected', 'liked', 'createdAt']) &&
        data.studioId is string && data.studioId.size() >= 1 && data.studioId.size() <= 128 && data.studioId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.galleryId is string && data.galleryId.size() >= 1 && data.galleryId.size() <= 128 && data.galleryId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.publicId is string && data.publicId.size() >= 1 && data.publicId.size() <= 200 &&
        data.secureUrl is string && data.secureUrl.size() >= 1 && data.secureUrl.size() <= 500 &&
        data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 160 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
        data.selected is bool &&
        data.liked is bool &&
        data.createdAt is timestamp;
    }

    // Admins Collection
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list, create, update, delete: if false;
    }

    // User Public Profile
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && existing().uid == request.auth.uid;
      allow create: if isVerifiedUser() && isValidId(userId) && isOwner(userId) &&
        isValidUserProfile(incoming()) && incoming().createdAt == request.time;
      allow update: if isVerifiedUser() && isValidId(userId) && isValidUserProfile(incoming()) && (
        isAdmin() || (
          isOwner(userId) &&
          incoming().uid == existing().uid &&
          incoming().role == existing().role &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'studioId', 'onboardingStep'])
        )
      );
      allow delete: if isValidId(userId) && isAdmin();

      // Isolated PII Subcollection
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if false;
        allow create: if isVerifiedUser() && isValidId(userId) && isValidId(docId) && docId == 'info' &&
          isOwner(userId) && isValidUserPrivateInfo(incoming()) && incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isVerifiedUser() && isValidId(userId) && isValidId(docId) && docId == 'info' &&
          isValidUserPrivateInfo(incoming()) && (
            isAdmin() || (
              isOwner(userId) &&
              incoming().uid == existing().uid &&
              incoming().createdAt == existing().createdAt &&
              incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone'])
            )
          );
        allow delete: if isValidId(userId) && isValidId(docId) && isAdmin();
      }
    }

    // Studios Collection
    match /studios/{studioId} {
      allow get: if isValidId(studioId) && ((isSignedIn() && existing().ownerId == request.auth.uid) || isAdmin());
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser() && isValidId(studioId) && isValidStudio(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isVerifiedUser() && isValidId(studioId) && isValidStudio(incoming()) && (
        isAdmin() || (
          existing().ownerId == request.auth.uid &&
          existing().subscriptionStatus != 'suspended' &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().subscriptionStatus == existing().subscriptionStatus &&
          incoming().diff(existing()).affectedKeys().hasOnly(['studioName', 'slug', 'watermarkText', 'subscriptionPlan'])
        )
      );
      allow delete: if isValidId(studioId) && isAdmin();
    }

    // Projects Collection
    match /projects/{projectId} {
      allow get: if isValidId(projectId) && (
        (isSignedIn() && existing().ownerId == request.auth.uid) || isAdmin()
      );
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser() && isValidId(projectId) && isValidProject(incoming()) &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/studios/$(incoming().studioId)) &&
        get(/databases/$(database)/documents/studios/$(incoming().studioId)).data.ownerId == request.auth.uid;
      allow update: if isVerifiedUser() && isValidId(projectId) && isValidProject(incoming()) && (
        isAdmin() || (
          existing().ownerId == request.auth.uid &&
          existing().status != 'delivered' &&
          incoming().ownerId == existing().ownerId &&
          incoming().studioId == existing().studioId &&
          incoming().createdAt == existing().createdAt &&
          exists(/databases/$(database)/documents/studios/$(existing().studioId)) &&
          get(/databases/$(database)/documents/studios/$(existing().studioId)).data.ownerId == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['projectName', 'projectType', 'eventDate', 'location', 'status'])
        )
      );
      allow delete: if isValidId(projectId) && (
        (isVerifiedUser() && existing().ownerId == request.auth.uid) || isAdmin()
      );
    }

    // Galleries Collection
    match /galleries/{galleryId} {
      allow get: if isValidId(galleryId) && (
        existing().accessType == 'public' ||
        (isSignedIn() && existing().ownerId == request.auth.uid) ||
        isAdmin()
      );
      allow list: if (isSignedIn() && existing().ownerId == request.auth.uid) || existing().accessType == 'public';
      allow create: if isVerifiedUser() && isValidId(galleryId) && isValidGallery(incoming()) &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/studios/$(incoming().studioId)) &&
        get(/databases/$(database)/documents/studios/$(incoming().studioId)).data.ownerId == request.auth.uid &&
        exists(/databases/$(database)/documents/projects/$(incoming().projectId)) &&
        get(/databases/$(database)/documents/projects/$(incoming().projectId)).data.ownerId == request.auth.uid;
      allow update: if isVerifiedUser() && isValidId(galleryId) && isValidGallery(incoming()) && (
        isAdmin() || (
          existing().ownerId == request.auth.uid &&
          existing().status != 'locked' &&
          incoming().ownerId == existing().ownerId &&
          incoming().studioId == existing().studioId &&
          incoming().projectId == existing().projectId &&
          incoming().createdAt == existing().createdAt &&
          exists(/databases/$(database)/documents/studios/$(existing().studioId)) &&
          get(/databases/$(database)/documents/studios/$(existing().studioId)).data.ownerId == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['galleryName', 'accessType', 'passwordHash', 'selectionLimit', 'watermarkEnabled', 'downloadEnabled', 'status'])
        )
      );
      allow delete: if isValidId(galleryId) && (
        (isVerifiedUser() && existing().ownerId == request.auth.uid) || isAdmin()
      );

      // Photos Subcollection
      match /photos/{photoId} {
        allow get: if isValidId(galleryId) && isValidId(photoId) && (
          (isSignedIn() && existing().ownerId == request.auth.uid) ||
          get(/databases/$(database)/documents/galleries/$(galleryId)).data.accessType == 'public' ||
          isAdmin()
        );
        allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
        allow create: if isVerifiedUser() && isValidId(galleryId) && isValidId(photoId) &&
          isValidPhotoAsset(incoming()) && incoming().galleryId == galleryId &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/galleries/$(galleryId)) &&
          get(/databases/$(database)/documents/galleries/$(galleryId)).data.ownerId == request.auth.uid;
        allow update: if isVerifiedUser() && isValidId(galleryId) && isValidId(photoId) &&
          isValidPhotoAsset(incoming()) && (
            isAdmin() || (
              existing().ownerId == request.auth.uid &&
              incoming().ownerId == existing().ownerId &&
              incoming().studioId == existing().studioId &&
              incoming().galleryId == existing().galleryId &&
              incoming().publicId == existing().publicId &&
              incoming().createdAt == existing().createdAt &&
              exists(/databases/$(database)/documents/galleries/$(galleryId)) &&
              get(/databases/$(database)/documents/galleries/$(galleryId)).data.status != 'locked' &&
              get(/databases/$(database)/documents/galleries/$(galleryId)).data.ownerId == request.auth.uid &&
              incoming().diff(existing()).affectedKeys().hasOnly(['selected', 'liked', 'category', 'fileName'])
            )
          );
        allow delete: if isValidId(galleryId) && isValidId(photoId) && (
          (isVerifiedUser() && existing().ownerId == request.auth.uid) || isAdmin()
        );
      }
    }
  }
}
